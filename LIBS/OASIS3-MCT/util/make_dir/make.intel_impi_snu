#
# Include file for OASIS3 Makefile for SNU system using ifort and impi
#
###############################################################################
#
# CHAN  : communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE        : path for oasis3-mct main directory (defined in .bash_profile)
COUPLE          = /home/sul/MIRAE-ESM/LIBS/OASIS3-MCT
#
# ARCHDIR       : directory created when compiling
ARCHDIR         = $(COUPLE)
#
# MPI library
MPIRUN = mpirun
#
# NETCDF library
NETCDF_INCLUDE  = `nf-config --includedir`
NETCDF_LIBRARY  = `nf-config --flibs`
#
# Compiling and other commands
MAKE        = gmake
F90         = mpiifx
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = mpiicx
LD          = mpiifx
AR          = ar
ARFLAGS     = -ruv
DYNOPT      = -fPIC
LDDYNOPT    = -shared ${NETCDF_LIBRARY}
# Fortran libraries for C linking
F2C_LIBS    = -lifcore -lifcoremt -lifport -limf
#
# CPP keys and compiler options
#
CPPDEF    = -Duse_netCDF -Duse_comm_$(CHAN) -D__VERBOSE  -DTREAT_OVERLAY
CCPPDEF   = -Duse_netCDF -Duse_comm_$(CHAN) -D__VERBOSE  -DTREAT_OVERLAY
#
# -g is necessary in F90FLAGS and LDFLAGS for pgf90 versions lower than 6.1
#
F90FLAGS_1  = -O2 -I. -assume byterecl
#F90FLAGS_1  = -g -traceback -fpe0 -O0 -I. -assume byterecl
f90FLAGS_1  = $(F90FLAGS_1)
FFLAGS_1    = $(F90FLAGS_1)
fFLAGS_1    = $(F90FLAGS_1)
CCFLAGS_1   = -O2
LDFLAGS     = $(F90FLAGS_1)  ${NETCDF_LIBRARY}
#
###################
#

# Additional definitions that should not be changed
#
# BINDIR        : directory for executables
BINDIR          = $(ARCHDIR)/bin
# INCPSMILE     : includes all *o and *mod for each library
INCPSMILE       = -I$(ARCHDIR)/include

F90FLAGS  = $(F90FLAGS_1) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
f90FLAGS  = $(f90FLAGS_1) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
FFLAGS    = $(FFLAGS_1) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
fFLAGS    = $(fFLAGS_1) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
CCFLAGS   = $(CCFLAGS_1) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
