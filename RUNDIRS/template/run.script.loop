#!/bin/sh

# ======================================================
# The following section requires user settings.
# ======================================================

#PBS -l nodes=8:ppn=60+2:ppn=60
#PBS -q workq
#PBS -V
#PBS -N MIRAE-ESM
#PBS -e /dev/null
#PBS -o /dev/null

NNODES_ATM=8
NNODES_OCN=2
PES_PER_NODE=60
NPES1=$((NNODES_ATM * PES_PER_NODE))
NPES2=$((NNODES_OCN * PES_PER_NODE))
NCOL=10 # set 0 if unknown; otherwise try different values to find a suitable one

LIBDIR=/home/sul/MIRAE-ESM/GRIMs/libs
CONDIR=${LIBDIR}/con
BINDIR=/home/sul/MIRAE-ESM/GRIMs/srcs/bin
OCNDIR=/home/sul/MIRAE-ESM/NEMO/cfgs/CPL_GRIMs/BLD/bin
NEMO_DATA_DIR=/home/sul/MIRAE-ESM/NEMO_DATA
CHEM_DATA_DIR=/home/sul/MIRAE-ESM/CHEM_DATA

# Simulation period settings
INIT_YEAR=1979   # Initial simulation year
SYEAR=1979       # Start year of current simulation cycle
EYEAR=1980       # End year of simulation

# ======================================================
# user setting section ends here
# ======================================================

cd $PBS_O_WORKDIR

sed "s|@NPES@|${NPES1}|g" namelist.grims_ > namelist.grims
sed -i "s|@NCOL@|${NCOL}|g" namelist.grims
sed -i "s|@CONDIR@|${CONDIR}|g" namelist.grims
sed "s|@CONDIR@|${CONDIR}|g" fcst.parm.tmp_ > fcst.parm.tmp
sed -i "s|@BINDIR@|${BINDIR}|g" fcst.parm.tmp
sed "s|@CHEM_DATA_DIR@|${CHEM_DATA_DIR}|g" input.geos_ > input.geos

# Copy model executables and link input data
if [ ! -s fcst.x ]; then cp -f ${BINDIR}/fcst.x .; fi
if [ ! -s nemo.exe ]; then cp -f ${OCNDIR}/nemo.exe .; fi
if [ ! -s ORCA_R2_zps_domcfg.nc ]; then ln -sf ${NEMO_DATA_DIR}/*.nc .; fi

# Determine restart mode
if [ $SYEAR -eq $INIT_YEAR ]; then
  RST=.false.    # First cycle (cold start)
else
  RST=.true.     # Restart run
fi

YEAR=$SYEAR
while [ $YEAR -le $EYEAR ]; do

  # Initialization step for cold start
  if [ "$RST" == ".false." ]; then

    # Remove old restart files
    rm -f chemi oasis_*_restart.nc

    # Prepare atmospheric initial conditions
    ${BINDIR}/mtn.x > mtn.out
    ${BINDIR}/chgr.x > chgr.out
    ${BINDIR}/sfc0.x > sfc0.out
    cp sigit sig.ft00
    cp sfci sfc.ft00
    cp ${NEMO_DATA_DIR}/EMPave_old.dat .

    # Create directory for saving NEMO restart files
    mkdir -p rst

  fi

  # Loop year range
  YS=$YEAR           # current year (start year of this loop)
  YE=$((YS + 1))     # next year (end year of this loop)

  # Hours since INIT_YEAR to YS
  FH0=$(TZ=UTC /home/sul/MIRAE-ESM/GRIMs/libs/etc/maketim ${INIT_YEAR}010100 -d ${YS}010100)

  # Duration in hours/seconds
  DFH=$(TZ=UTC /home/sul/MIRAE-ESM/GRIMs/libs/etc/maketim ${YS}010100 -d ${YE}010100)
  DFSEC=$((DFH * 3600))

  # Forecast hour start/end for this loop
  FHS=$((FH0 + 1))
  FHE=$((FH0 + DFH))

  # Initial and End timestep for NEMO
  ITS=$((FH0 / 3 * 2 + 1))
  ITE=$(((FH0 + DFH) / 3 * 2))

  # Zero-padded 8-digit for NEMO restart files
  IT0=$(printf "%08d" "$((ITS - 1))")

  # Generate namelist files by replacing placeholders
  sed "s/@FHE@/${FHE}/g" fcst.parm.tmp > fcst.parm
  sed "s/@IT0@/${IT0}/g" namelist_ice_cfg.tmp > namelist_ice_cfg
  sed "s/@IT0@/${IT0}/g" namelist_top_cfg.tmp > namelist_top_cfg
  sed -i "s/@RST@/${RST}/g" namelist_top_cfg
  sed "s/@IT0@/${IT0}/g" namelist_cfg.tmp > namelist_cfg
  sed -i "s/@RST@/${RST}/g" namelist_cfg
  sed -i "s/@YEAR@/${YEAR}/g" namelist_cfg
  sed -i "s/@ITS@/${ITS}/g" namelist_cfg
  sed -i "s/@ITE@/${ITE}/g" namelist_cfg
  sed "s/@DFSEC@/${DFSEC}/g" namcouple.tmp > namcouple

  # Execute MIRAE-ESM
  mpirun -f $PBS_NODEFILE -ppn ${PES_PER_NODE} -np ${NPES1} ./fcst.x : -np ${NPES2} ./nemo.exe 1>run.output 2>&1

  # Check error
  fin=`grep 'Wall-clock-time' run.output | wc -l`
  if [ $fin -eq 0 ]; then
    exit 8
  fi

  # Move output data to the new directory
  mkdir -p $YEAR
  /usr/bin/mv -f EMPave.dat EMPave_old.dat
  /usr/bin/mv -f ORCA2_*.nc grims.*.nc ctm.bpch.* run.output ocean.output $YEAR
  /usr/bin/cp -f sfci sigit sigitdt sig_restart nco_restart cpl_restart lsm_restart $YEAR
  /usr/bin/cp -f chemi megani cspeci EMPave_old.dat oasis_*_restart.nc $YEAR

  # Set restart flag for next year
  RST=.true.

  # Go to the next year
  YEAR=`expr $YEAR + 1`

done
