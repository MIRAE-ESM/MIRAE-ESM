#!/bin/sh
#PBS -l nodes=9:ppn=64
#PBS -q workq
#PBS -V
#PBS -N GRIMs-NEMO
#PBS -j eo

echo 'run start'

cd $PBS_O_WORKDIR

# Simulation period settings
INIT_YEAR=1979   # Initial simulation year
SYEAR=1979       # Start year of current simulation cycle
EYEAR=1990       # End year of simulation

# Determine restart mode
if [ $SYEAR -eq $INIT_YEAR ]; then
  RST=.false.    # First cycle (cold start)
else
  RST=.true.     # Restart run
fi

YEAR=$SYEAR
while [ $YEAR -le $EYEAR ]; do

  # Initialization step for cold start
  if [ "$RST" == ".false." ]; then

    # Copy model executables
    cp -f /home/sul/GRIMs-NEMO/GRIMs/srcs/bin/chgr.x .
    cp -f /home/sul/GRIMs-NEMO/GRIMs/srcs/bin/fcst.x .
    cp -f /home/sul/GRIMs-NEMO/GRIMs/srcs/bin/mtn.x .
    cp -f /home/sul/GRIMs-NEMO/GRIMs/srcs/bin/sfc0.x .
    cp -f /home/sul/GRIMs-NEMO/NEMO/cfgs/CPL_GRIMs/BLD/bin/nemo.exe .

    # Copy or link input data
    cp -f /home/sul/GRIMs-NEMO/NEMO_DATA/EMPave_old.dat EMPave_old.dat
    ln -sf /home/sul/GRIMs-NEMO/NEMO_DATA/*.nc .

    # Remove old restart files
    rm -f chemi oasis_*_restart.nc

    # Prepare atmospheric initial conditions
    ./mtn.x > mtn.out
    ./chgr.x > chgr.out
    ./sfc0.x > sfc0.out
    cp -f sigit sig.ft00
    cp -f sfci sfc.ft00

    # Create directory for saving NEMO restart files
    mkdir -p rst

  fi

  # Loop year range
  YS=$YEAR           # current year (start year of this loop)
  YE=$((YS + 1))     # next year (end year of this loop)

  # Hours since INIT_YEAR to YS
  FH0=$(TZ=UTC /home/sul/GRIMs-NEMO/GRIMs/libs/etc/maketim ${INIT_YEAR}010100 -d ${YS}010100)

  # Duration in hours/seconds
  DFH=$(TZ=UTC /home/sul/GRIMs-NEMO/GRIMs/libs/etc/maketim ${YS}010100 -d ${YE}010100)
  DFSEC=$((DFH * 3600))

  # Forecast hour start/end for this loop
  FHS=$((FH0 + 1))
  FHE=$((FH0 + DFH))

  # Initial and End timestep for NEMO
  ITS=$((FH0 / 3 * 2 + 1))
  ITE=$(((FH0 + DFH) / 3 * 2))

  # Zero-padded 8-digit for NEMO restart files
  IT0=$(printf "%08d" "$((ITS - 1))")

  # Generate namelist files by replacing placeholders
  sed "s/@FHE@/${FHE}/g" fcst.parm.tmp > fcst.parm
  sed "s/@IT0@/${IT0}/g" namelist_ice_cfg.tmp > namelist_ice_cfg
  sed "s/@IT0@/${IT0}/g" namelist_top_cfg.tmp > namelist_top_cfg
  sed -i "s/@RST@/${RST}/g" namelist_top_cfg
  sed "s/@IT0@/${IT0}/g" namelist_cfg.tmp > namelist_cfg
  sed -i "s/@RST@/${RST}/g" namelist_cfg
  sed -i "s/@YEAR@/${YEAR}/g" namelist_cfg
  sed -i "s/@ITS@/${ITS}/g" namelist_cfg
  sed -i "s/@ITE@/${ITE}/g" namelist_cfg
  sed "s/@DFSEC@/${DFSEC}/g" namcouple.tmp > namcouple

  # Execute GRIMs-NEMO
  mpirun -f $PBS_NODEFILE -ppn 60 -np 480 ./fcst.x : -np 60 ./nemo.exe 1>run.output 2>&1

  # Check error
  fin=`grep 'Wall-clock-time' run.output | wc -l`
  if [ $fin -eq 0 ]; then
    exit 8
  fi

  # Move output data to the new directory
  mkdir -p $YEAR
  /usr/bin/mv -f EMPave.dat EMPave_old.dat
  /usr/bin/mv -f ORCA2_*.nc grims.*.nc ctm.bpch.* run.output ocean.output $YEAR
  /usr/bin/cp -f sfci sigit sigitdt sig_restart nco_restart cpl_restart lsm_restart $YEAR
  /usr/bin/cp -f chemi megani cspeci EMPave_old.dat oasis_*_restart.nc $YEAR

  # Set restart flag for next year
  RST=.true.

  # Go to the next year
  YEAR=`expr $YEAR + 1`

done

echo 'run end'
